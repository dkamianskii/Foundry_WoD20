<div class="sheet-headline sheet-banner-small splatFont">
    <span class="sheet-banner-text">{{localize "wod.health.health"}}</span>
</div>

<div class="sheet-boxcontainer">
    <div>{{localize "wod.health.current"}}: {{health.current}} / {{health.max}}</div>
</div>

<div class="sheet-boxcontainer">
    {{#each health.levels as |level|}}
        {{#if (gt level.count 0)}}
            <div class="health" title="{{localize level.label}} ({{level.penalty}})">
                <div class="resource-counter healthbox" data-name="system.health.{{level.id}}">
                    {{#each level.boxes as |box|}}
                        <span class="resource-value-step healthBox wound-track-box {{level.id}}"
                            data-type="{{@root.config.sheettype.mortal}}"
                            data-action="editHealth"
                            data-index="{{box.index}}"
                            data-state="{{box.severity}}"
                            data-wound-mark="{{box.displayState}}"></span>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/each}}
</div>

{{#if health.overflow.length}}
    <div class="sheet-boxcontainer information-area">
        {{localize "wod.health.overflow"}}: {{health.overflow.length}}
    </div>
{{/if}}

{{#if actor.system.settings.usechimerical}}
    <div class="sheet-headline sheet-banner-small splatFont">
        <span class="sheet-banner-text">{{localize "wod.health.chimerical"}}</span>
    </div>

    <div class="sheet-boxcontainer">
        {{#each chimericalhealth.levels as |level|}}
            {{#if (gt level.count 0)}}
                <div class="health" title="{{localize level.label}}">
                    <div class="resource-counter healthbox" data-name="system.health.chimerical.{{level.id}}">
                        {{#each level.boxes as |box|}}
                            <span class="resource-value-step healthBox {{level.id}}"
                                data-type="{{@root.config.sheettype.changeling}}"
                                data-action="editHealth"
                                data-index="{{box.index}}"
                                data-state="{{box.legacyMarker}}"></span>
                        {{/each}}
                    </div>
                </div>
            {{/if}}
        {{/each}}
    </div>
{{/if}}

<div class="sheet-boxcontainer">
    <div class="information-area">{{localize "wod.health.penalty"}}: {{ignorePain actor.system.health.damage.woundpenalty}}</div>
</div>
