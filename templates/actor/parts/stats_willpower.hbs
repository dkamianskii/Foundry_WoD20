<div class="sheet-headline sheet-banner-small splatFont vrollable"
    data-action="rollDice"
    data-type="{{config.sheettype.mortal}}"
    data-key="willpower"
    data-noability="true">
    <span class="sheet-banner-text">{{localize "wod.advantages.willpower"}}</span>
</div>

<div class="sheet-boxcontainer willpower-track" title="{{localize 'wod.advantages.willpowertrackhint'}}">
    {{#each willpower.levels as |level|}}
        {{#if (gt level.count 0)}}
            <div class="health" title="{{localize level.label}} ({{level.penalty}})">
                <div class="resource-counter healthbox">
                    {{#each level.boxes as |box|}}
                        <span class="resource-value-step healthBox wound-track-box {{level.id}}"
                            data-action="editWillpower"
                            data-index="{{box.index}}"
                            data-state="{{box.severity}}"
                            data-wound-mark="{{box.displayState}}"></span>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/each}}
</div>

<div class="information-area centerText">
    {{localize "wod.advantages.currentwillpower"}}: {{willpower.current}} / {{willpower.maximum}}
    &mdash; {{localize "wod.health.penalty"}}: {{effectiveWoundPenalty willpower}}
</div>
